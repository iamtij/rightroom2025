SITE_URL=https://ibmcph.com
IBMC_DB_PATH=data/ibmc.sqlite
# production | staging — staging is required for Paynamics staging-live merchant mode
IBMC_DEPLOYMENT_ENV=production
REMINDERS_ENABLED=true

# Staging only. Set to true to suppress outbound email/SMS and automatic encrypted backups.
# Member and registration email login codes still send (see docs/staging-safe-mode.md).
IBMC_STAGING_SAFE_MODE=

# Resend. The from-address domain has to be verified in Resend before mail delivers.
# Leave the key empty to record the message without sending.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=IBMC 2027 <tickets@ibmcph.com>
EMAIL_REPLY_TO=tickets@ibmcph.com
# Comma-separated inboxes for the 9:00 AM PHT registration report. Leave empty to skip.
DAILY_REPORT_TO=
# Count-only registration poster at 9:00 AM PHT. Defaults to this address when unset.
REGISTRATION_POSTER_TO=tjtalusan@gmail.com

# Semaphore. Approve this sender name in the Semaphore dashboard first.
# A phone sender id is 11 letters or numbers and cannot contain a space.
# Leave the key empty to record the message without sending.
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=IBMC2027

# Dev and staging only. Production ignores this even if it is set.
ALLOW_TEST_TICKET=

# Dev and staging only. Sells test_100, test_200, and the legacy test_50 member path. Production ignores this.
ALLOW_TEST_REGISTRATION=
# Staging identity is required. Railway staging, or IBMC_DEPLOYMENT_ENV=staging for local dev. Production never qualifies.
IBMC_STAGING_EARLY_PAYMENTS=

ADMIN_EMAIL=admin@ibmcph.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. Leave empty to keep using ADMIN_SESSION_SECRET for email codes and member edit links.
OTP_SECRET=
MEMBER_EDIT_SECRET=

# Staging only: skip Turnstile on new checkout (Railway staging identity). Requires IBMC_STAGING_SKIP_TURNSTILE_CHECKOUT=true.
IBMC_STAGING_SKIP_TURNSTILE_CHECKOUT=

# Optional Cloudflare Turnstile. Both keys must be set for the widget to appear on registration.
# Local dev: leave both empty to skip Turnstile. If both are set, TURNSTILE_SITE_KEY must be valid for your dev hostname (e.g. localhost allowed in the Cloudflare widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# UnionBank UPay — live whitelabel + partner API (see docs/upay-staging-live.md)
UPAY_PAGE_URL=https://sith.unionbankph.com/UPAY/Whitelabel
UPAY_BILLER_UUID=
UPAY_BILLER_NAME=
# Production partner API: https://api.unionbankph.com/ubp/external
# Sandbox: https://api-uat.unionbankph.com/partners/sb
UPAY_BASE_URL=
UPAY_CLIENT_ID=
UPAY_CLIENT_SECRET=
UPAY_PARTNER_ID=
UPAY_USERNAME=
UPAY_PASSWORD=
UPAY_SCOPE=upay_payments
UPAY_AES_KEY=
UPAY_CALLBACK_URL=
# Do not set unless UnionBank confirms bare whitelabel URLs work for Profile ID (otherwise Processing Error).
UPAY_WHITELABEL_DIRECT=

# HitPay. The API key and salt stay on the server. Sandbox does not cover QR Ph or UnionBank Online.
# HITPAY_SALT is the salt HitPay shows for the IBMC webhook endpoint, not the API-key salt.
# Subscribe that endpoint to payment_request.completed only.
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_API_BASE_URL=https://api.hit-pay.com
HITPAY_CHECKOUT_TTL_MINUTES=15
PUBLIC_WEB_URL=https://ibmcph.com

# Paynamics Checkout (Workflow). Wiki §1.6 test host: https://payin.payserv.net — do not enable API calls until BNI TEST credentials are provisioned.
# Contract: docs/paynamics/wiki-contracts-extract.md
PAYNAMICS_API_BASE_URL=
PAYNAMICS_API_CALLS_ENABLED=
PAYNAMICS_API_ACCOUNT_CONFIRMED=
PAYNAMICS_API_ENV=sandbox
# Staging-only live merchant (real charges at Paynamics — NOT on IBMC_DEPLOYMENT_ENV=production):
# PAYNAMICS_STAGING_LIVE_MERCHANT=true, PAYNAMICS_API_LIVE_ACCOUNT_CONFIRMED=true,
# PAYNAMICS_API_ENV=live, PAYNAMICS_LIVE_API_ORIGIN_ALLOWLIST=<Paynamics-confirmed Workflow origin(s) only>
# Production (ibmcph.com): PAYNAMICS_PRODUCTION_LIVE_MERCHANT=true, PAYNAMICS_SETTLEMENT_ENABLED=true
PAYNAMICS_PRODUCTION_LIVE_MERCHANT=
PAYNAMICS_STAGING_LIVE_MERCHANT=
PAYNAMICS_API_LIVE_ACCOUNT_CONFIRMED=
PAYNAMICS_LIVE_API_ORIGIN_ALLOWLIST=
PAYNAMICS_PAYMENT_HOST_ALLOWLIST=payserv.net
PAYNAMICS_BASIC_AUTH_USER=
PAYNAMICS_BASIC_AUTH_PASSWORD=
PAYNAMICS_MERCHANT_ID=
PAYNAMICS_MERCHANT_KEY=
PAYNAMICS_NOTIFICATION_URL=
PAYNAMICS_CANCEL_URL=
PAYNAMICS_PMETHOD=
PAYNAMICS_PCHANNEL=
PAYNAMICS_COLLECTION_METHOD=single_pay
PAYNAMICS_PAYMENT_NOTIFICATION_STATUS=1
PAYNAMICS_PAYMENT_NOTIFICATION_CHANNEL=1
PAYNAMICS_DESCRIPTOR=
PAYNAMICS_CHECKOUT_TTL_MINUTES=30
PAYNAMICS_DEFAULT_ADDRESS1=Makati
PAYNAMICS_DEFAULT_ADDRESS2=
PAYNAMICS_DEFAULT_CITY=Makati
PAYNAMICS_DEFAULT_STATE=PH-00
PAYNAMICS_DEFAULT_COUNTRY=PH
PAYNAMICS_DEFAULT_ZIP=1200
PAYNAMICS_DEFAULT_DOB=
# Leave unset on staging/sandbox (settlement on when API admission passes). Set false to block recordPayment; set true to allow on IBMC production.
PAYNAMICS_SETTLEMENT_ENABLED=

# Error reporting. Leave both unset to disable Sentry. VITE_SENTRY_DSN is public and inlined at build time.
# SENTRY_ENVIRONMENT and SENTRY_RELEASE are optional; Railway's environment name and commit are used when unset.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Build-time token that uploads browser source maps. Leave unset to skip the upload.
SENTRY_AUTH_TOKEN=

# Nightly encrypted SQLite copies. On Railway these point at the ibmc-backups bucket.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
