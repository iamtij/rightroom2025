SITE_URL=https://ibmcph.com
IBMC_DB_PATH=data/ibmc.sqlite
REMINDERS_ENABLED=true

# Resend. The from-address domain has to be verified in Resend before mail delivers.
# Leave the key empty to record the message without sending.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=IBMC 2027 <tickets@ibmcph.com>
EMAIL_REPLY_TO=tickets@ibmcph.com

# Semaphore. Approve this sender name in the Semaphore dashboard first.
# A phone sender id is 11 letters or numbers and cannot contain a space.
# Leave the key empty to record the message without sending.
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=IBMC2027

# Leave empty. Set to true only when a ₱10 test ticket should exist and be allowed to issue an entry pass.
ALLOW_TEST_TICKET=

# Leave empty. Set to true only on a local or staging process that should sell the ₱50 and ₱200 test tickets.
ALLOW_TEST_REGISTRATION=

ADMIN_EMAIL=admin@ibmcph.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. Leave empty to keep using ADMIN_SESSION_SECRET for email codes and member edit links.
OTP_SECRET=
MEMBER_EDIT_SECRET=

# Optional Cloudflare Turnstile. Both keys are required before the checkbox appears.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# UnionBank UPay production page. The biller UUID and AES key are the production credentials.
UPAY_PAGE_URL=https://sith.unionbankph.com/UPAY/Whitelabel
UPAY_BILLER_UUID=
UPAY_BILLER_NAME=
UPAY_AES_KEY=
UPAY_CALLBACK_URL=

# HitPay. The API key and salt stay on the server. Sandbox does not cover QR Ph or UnionBank Online.
# HITPAY_SALT is the salt HitPay shows for the IBMC webhook endpoint, not the API-key salt.
# Subscribe that endpoint to payment_request.completed only.
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_API_BASE_URL=https://api.hit-pay.com
HITPAY_CHECKOUT_TTL_MINUTES=15
PUBLIC_WEB_URL=https://ibmcph.com

# Paynamics Checkout (Workflow) — REST JSON + HTTP Basic. Do not set API_CALLS_ENABLED until Paynamics confirms BNI sandbox host.
# Postman reference: docs/paynamics/workflow.postman_collection.sanitized.json
PAYNAMICS_API_BASE_URL=
PAYNAMICS_API_CALLS_ENABLED=
PAYNAMICS_API_ACCOUNT_CONFIRMED=
PAYNAMICS_API_ENV=sandbox
PAYNAMICS_BASIC_AUTH_USER=
PAYNAMICS_BASIC_AUTH_PASSWORD=
PAYNAMICS_MERCHANT_ID=
PAYNAMICS_MERCHANT_KEY=
PAYNAMICS_NOTIFICATION_URL=
PAYNAMICS_CANCEL_URL=
PAYNAMICS_PMETHOD=
PAYNAMICS_PCHANNEL=
PAYNAMICS_COLLECTION_METHOD=single_pay
PAYNAMICS_PAYMENT_NOTIFICATION_STATUS=1
PAYNAMICS_PAYMENT_NOTIFICATION_CHANNEL=1
PAYNAMICS_DESCRIPTOR=
PAYNAMICS_CHECKOUT_TTL_MINUTES=30
PAYNAMICS_ALLOW_PRODUCTION=
PAYNAMICS_SETTLEMENT_ENABLED=
PAYNAMICS_NOTIFICATION_VERIFY_CONTRACT=
PAYNAMICS_QUERY_SETTLEMENT_ENABLED=
PAYNAMICS_DEFAULT_ADDRESS1=Makati
PAYNAMICS_DEFAULT_ADDRESS2=
PAYNAMICS_DEFAULT_CITY=Makati
PAYNAMICS_DEFAULT_STATE=PH-00
PAYNAMICS_DEFAULT_COUNTRY=PH
PAYNAMICS_DEFAULT_ZIP=1200
PAYNAMICS_DEFAULT_DOB=

# Nightly encrypted SQLite copies. On Railway these point at the ibmc-backups bucket.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
